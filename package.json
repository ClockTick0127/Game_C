{
  "name": "game-calendar",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "0.1.0",
  "description": "게임 출시 일정을 캘린더로 보여주는 웹사이트",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n back,front -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"backend/src/**/*.ts\" \"backend/test/**/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.{ts,html}\" \"*.mjs\"",
    "format:check": "prettier --check \"backend/src/**/*.ts\" \"backend/test/**/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.{ts,html}\" \"*.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClockTick0127/Test_PJT1.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
