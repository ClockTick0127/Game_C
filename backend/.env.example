# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# https://rawg.io/apidocs 에서 무료로 발급받은 API 키. 비워두면 샘플 데이터로 응답합니다.
RAWG_API_KEY=
# API 서버 포트 (frontend/vite.config.ts의 프록시 대상과 맞춰야 합니다)
API_PORT=4000

# --- 프로덕션 ---
# 실행: npm run build && NODE_ENV=production npm start -w backend
# (frontend/dist가 있으면 API 서버가 화면도 함께 서빙합니다)
# NODE_ENV=production
# 리버스 프록시(nginx, 클라우드 로드밸런서 등) 뒤에서 실행할 때 프록시 단계 수
# TRUST_PROXY=1
# SQLite DB 파일 경로 (기본: backend/data/app.db)
# DB_PATH=

# 화면과 다른 주소에서 API를 호출해야 할 때만 허용할 출처 (쉼표로 구분)
# 같은 주소(프록시 포함)에서 서빙하면 필요 없습니다. 프록시 뒤에서는 TRUST_PROXY도 함께 설정하세요.
# ALLOWED_ORIGINS=https://app.example.com

# 서버 전체가 RAWG로 보낼 수 있는 분당 요청 수 (기본 120). 무료 요금제 한도가 한꺼번에 소진되는 것을 막는 상한이며,
# 넘으면 새 조회는 503으로 응답하고 이미 캐시된 결과는 계속 제공합니다.
# RAWG_MAX_CALLS_PER_MINUTE=120

# 서버 전체가 Apple iTunes API(iOS 게임 정보)로 보낼 수 있는 분당 요청 수 (기본 15). Apple은 분당 20회 안팎을 넘으면 요청을 거절합니다.
# ITUNES_MAX_CALLS_PER_MINUTE=15

# 요청 로그(요청 ID, 메서드, 경로, 상태 코드, 걸린 시간). 기본은 켜짐이며 0으로 끕니다.
# LOG_REQUESTS=0
